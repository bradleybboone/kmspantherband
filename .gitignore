# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# WSL/NTFS alternate data stream artifacts
*:Zone.Identifier

# Source material handed over for content updates — never served, never committed.
# Originals carry camera EXIF (including GPS) and are large.
*.jpeg
Elementary Packet*.pdf

# Cloudflare / OpenNext build output
/.open-next/
.wrangler/

# Impeccable design-skill working context — local design guidance, not site
# content. Kept out of the repo by the director's call (2026-08-09).
/PRODUCT.md
/DESIGN.md
/.impeccable/
